			<Comment><![CDATA[
	Rising Edge detection.
]]></Comment>
			<BitSize>128</BitSize>
			<SubItem>
				<Name>CLK</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
				<Comment><![CDATA[ Signal to detect ]]></Comment>
