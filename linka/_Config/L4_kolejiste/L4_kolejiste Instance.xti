				<Text><![CDATA[TO_COMPLETING]]></Text>
				<Enum>7</Enum>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[TO_COMPLETE]]></Text>
				<Enum>8</Enum>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[TO_ABORTING]]></Text>
				<Enum>9</Enum>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[TO_ABORTED]]></Text>
				<Enum>10</Enum>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[TO_CLEARING]]></Text>
				<Enum>11</Enum>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[TO_MANUAL]]></Text>
				<Enum>12</Enum>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[TO_SERVICE]]></Text>
				<Enum>13</Enum>
			</EnumInfo>
