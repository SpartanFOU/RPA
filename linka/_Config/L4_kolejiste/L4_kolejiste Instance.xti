		<DataType>
			<Name GUID="{82C5C7D3-EF5E-4F23-9CCD-22138F18AD94}" AutoDeleteType="true">E_SystemState</Name>
			<Comment><![CDATA[ PackML-inspired operating state enumeration.
 Numeric values match SCADA.systemstav (%MW106) encoding.]]></Comment>
			<BitSize>16</BitSize>
			<BaseType GUID="{18071995-0000-0000-0000-000000000004}">WORD</BaseType>
			<EnumInfo>
				<Text><![CDATA[STOPPED]]></Text>
				<Enum>0</Enum>
				<Comment><![CDATA[ Všechny výstupy de-energizovány; systém bezpečný]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[STARTING]]></Text>
				<Enum>1</Enum>
				<Comment><![CDATA[ Inicializace: čtení poloh výhybek, převzetí řízení]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[RUNNING]]></Text>
				<Enum>2</Enum>
				<Comment><![CDATA[ Normální automatický provoz]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[HOLDING]]></Text>
				<Enum>3</Enum>
				<Comment><![CDATA[ Přechodový stav: zastavování lokomotivy]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[HELD]]></Text>
				<Enum>4</Enum>
				<Comment><![CDATA[ Pozastaveno; čeká na Resume]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[RESUMING]]></Text>
				<Enum>5</Enum>
				<Comment><![CDATA[ Obnovení jízdy po HELD]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[COMPLETING]]></Text>
				<Enum>6</Enum>
				<Comment><![CDATA[ Plynné zastavení sekvence]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[COMPLETE]]></Text>
				<Enum>7</Enum>
				<Comment><![CDATA[ Sekvence dokončena; čeká na Reset]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[ABORTING]]></Text>
				<Enum>8</Enum>
				<Comment><![CDATA[ Okamžité zastavení všech výstupů]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[ABORTED]]></Text>
				<Enum>9</Enum>
				<Comment><![CDATA[ Porucha; čeká na Clear od operátora]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[CLEARING]]></Text>
				<Enum>10</Enum>
				<Comment><![CDATA[ Potvrzení poruchy, reset výstupů]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[MANUAL]]></Text>
				<Enum>11</Enum>
				<Comment><![CDATA[ Manuální režim s antikolizní ochranou]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[SERVICE]]></Text>
				<Enum>12</Enum>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[WAITING_DIR]]></Text>
				<Enum>13</Enum>
				<Comment><![CDATA[ Servisní režim (PIN); antikolize vypnuta]]></Comment>
			</EnumInfo>
			<Properties>
				<Property>
					<Name>strict</Name>
				</Property>
				<Property>
					<Name>generate_implicit_init_function</Name>
				</Property>
			</Properties>
		</DataType>
		<DataType>
			<Name GUID="{61651CA7-5232-4DDE-CAC1-32F6308032D0}" AutoDeleteType="true">E_StateCmd</Name>
			<Comment><![CDATA[ Commands returned by state FBs to FB_MachineControl.
 MachineControl reads outCmd each cycle and performs the transition.]]></Comment>
			<BitSize>16</BitSize>
