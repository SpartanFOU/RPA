		<DataType>
			<Name GUID="{2A518946-E6C8-1E94-E098-5ECEC0A68919}" AutoDeleteType="true">FB_DriveCtrl</Name>
			<Comment><![CDATA[ Locomotive drive control.
 Enforces mutual exclusion between KLADNY and OPACNY.
 Detects voltage fault: PRE_KLA AND PRE_OPA both TRUE simultaneously.
 Fault is latched — cleared only when FB_MachineControl enters CLEARING state
 (inClearFault = TRUE for one scan).]]></Comment>
			<BitSize>256</BitSize>
			<SubItem>
				<Name>inEnable</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
				<Comment><![CDATA[ TRUE = auto or manual mode active]]></Comment>
				<BitSize>8</BitSize>
				<BitOffs>64</BitOffs>
				<Properties>
					<Property>
						<Name>ItemType</Name>
						<Value>Input</Value>
					</Property>
				</Properties>
			</SubItem>
			<SubItem>
				<Name>inClearFault</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
				<Comment><![CDATA[ TRUE for one scan when CLEARING state entered]]></Comment>
				<BitSize>8</BitSize>
				<BitOffs>72</BitOffs>
				<Properties>
					<Property>
						<Name>ItemType</Name>
						<Value>Input</Value>
					</Property>
				</Properties>
			</SubItem>
