<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <GVL Name="IO" Id="{8a6001b6-22d0-4c8e-b274-231493fc645b}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
	DI0 AT %IX0.0: BOOL;	// Poloha levé výhybky (1 = vnější kolej)
	DI1 AT %IX0.1: BOOL;	// Poloha pravé výhybky (1 = vnější kolej)
	DI2 AT %IX0.2: BOOL;	// Poloha zadní výhybky (1 = vnější kolej)
	DI3 AT %IX0.3: BOOL;	// Poloha I přepínače (1 = přep. v poloze I)
	DI4 AT %IX0.4: BOOL;	// Poloha II přepínače (1 = přep. v poloze II)
	DI5 AT %IX0.5: BOOL;	// Tlačítko levé výhybky (1 = tlačítko stisknuto)
	DI6 AT %IX0.6: BOOL;	// Tlačítko pravé výhybky (1 = tlačítko stisknuto)
	DI7 AT %IX0.7: BOOL;	// Tlačítko zadní výhybky (1 = tlačítko stisknuto)
	DI8 AT %IX1.0: BOOL;	// Pravé hradlo (1 = přítomno vozidlo)
	DI9 AT %IX1.1: BOOL;	// Levé hradlo (1 = přítomno vozidlo)
	DI10 AT %IX1.2: BOOL;	// Zadní hradlo (1 = přítomno vozidlo)
	DI11 AT %IX1.3: BOOL;	// Hradlo závor (1 = přítomno vozidlo)

	DO4 AT %QX0.4: BOOL;	// Stahování závor (1 = závory staženy)
	DO5 AT %QX0.5: BOOL;	// Jízda v kladném směru (1 = jede)
	DO6 AT %QX0.6: BOOL;	// Jízda v opačném směru (1 = jede)
	DO7 AT %QX0.7: BOOL;	// Přestavování levé výhybky (1 = přestavit)
	DO8 AT %QX1.0: BOOL;	// Přestavování pravé výhybky (1 = přestavit)
	DO9 AT %QX1.1: BOOL;	// Přestavování zadní výhybky (1 = přestavit)
	DO10 AT %QX1.2: BOOL;	// Převzetí ovládání výhybek (1 = ovládá automat)
	DO11 AT %QX1.3: BOOL;	// Převzetí ovládání jízdy (1 = ovládá automat)
END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>