<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="FB_SwitchRouter" Id="{a1b2c3d4-0006-4000-8000-000000000006}" SpecialFunc="None">
    <Declaration><![CDATA[// L4b — Switch routing (výhybkový automat).
// Aligns left (C) and right (D) double-track switches based on drive direction.
// State machine: IDLE → IMPULSE (both LEV+PRA simultaneously) → WAIT (50 ms settle) → IDLE
// Impulse runs up to 1 s; stops early if position sensors confirm both switches moved.
// Runs only when inEnable = TRUE (set by FB_MachineControl).
FUNCTION_BLOCK FB_SwitchRouter
VAR_INPUT
    inEnable      : BOOL;  // TRUE = auto mode active
    inManEnable   : BOOL;  // TRUE = manual mode active
    inVYHYBKY     : BOOL;  // PLC vlastní řízení výhybek (auto guard)
    inVYH_LEV     : BOOL;  // Poloha levé výhybky (1 = vnější kolej)
    inVYH_PRA     : BOOL;  // Poloha pravé výhybky (1 = vnější kolej)
    inHRA_LEV     : BOOL;  // SP1 — vozidlo na levém hradle (nesmí přestavovat)
    inHRA_PRA     : BOOL;  // Vozidlo na pravém hradle (nesmí přestavovat)
    inKLADNY      : BOOL;  // Směr jízdy: kupředu
    inOPACNY      : BOOL;  // Směr jízdy: pozpátku
    inClearFault  : BOOL;  // TRUE for one scan when CLEARING state entered (from MAIN rClearing.Q)

    // Manual overrides
    inMan_IMP_LEV : BOOL;
    inMan_IMP_PRA : BOOL;
    inMan_IMP_ZAD : BOOL;
END_VAR
VAR_OUTPUT
    outIMP_LEV  : BOOL;  // Impuls levé výhybky
    outIMP_PRA  : BOOL;  // Impuls pravé výhybky
    outIMP_ZAD  : BOOL;  // Impuls zadní výhybky (rozšíření)
    outFault     : BOOL;
    outFaultCode : WORD;
    outTechstav  : BYTE;  // Stav L4b: 0=IDLE, 1=IMPULSE, 2=WAIT (→ low byte %MW104)
END_VAR
VAR
    eState          : INT := 0;
    // 0=IDLE, 1=IMPULSE (levá+pravá současně), 2=WAIT (50 ms settle)

    bFault_latch    : BOOL;   // Latch: porucha drží až do CLEARING
    wFaultCode_hold : WORD;   // Uložení kódu poruchy po latch

    bReqOuter       : BOOL;  // Požadovaná poloha: TRUE = vnější kolej (kladný směr)
    bLEV_Wrong      : BOOL;  // Levá výhybka v nesprávné poloze
    bPRA_Wrong      : BOOL;  // Pravá výhybka v nesprávné poloze

    tImpLEV         : TON;   // Impulse hold timer (shared by both IMP_LEV and IMP_PRA)
    tWaitL          : TON;   // 50 ms settle wait after impulse
    tMismatch       : TON;   // 200 ms mismatch fault timeout (VYH_LEV ≠ VYH_PRA)
    tDebounce       : TON;   // 2 s debounce after toggle in OPACNY direction
    tPreSwitch      : TON;   // 1 s pre-switch delay before toggle in OPACNY direction

    rtrigHRA_PRA    : R_TRIG;  // Rising edge — train arrives at right gate
    bTargetOuter    : BOOL;    // Target switch position (toggled on HRA_PRA rising edge)
    bDebouncing     : BOOL;    // TRUE while debounce is active
    bPending        : BOOL;    // Toggle pending, waiting for pre-switch delay

    c_tImpulseMax   : TIME := T#1000MS;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ═══════════════════════════════════════════════════════════════════════
// 1. Clear fault latch when CLEARING state reached
// ═══════════════════════════════════════════════════════════════════════
IF inClearFault THEN
    bFault_latch    := FALSE;
    wFaultCode_hold := 0;
END_IF

// ═══════════════════════════════════════════════════════════════════════
// 2. Publish latched fault to outputs
// ═══════════════════════════════════════════════════════════════════════
outFault     := bFault_latch;
outFaultCode := wFaultCode_hold;

// ═══════════════════════════════════════════════════════════════════════
// 3. Manual mode — bypass state machine
// ═══════════════════════════════════════════════════════════════════════
IF NOT inEnable THEN
    IF inManEnable THEN
        
        // Parallel rails: switching one side must always switch both
        outIMP_LEV := inMan_IMP_LEV OR inMan_IMP_PRA;
        outIMP_PRA := inMan_IMP_LEV OR inMan_IMP_PRA;
        outIMP_ZAD := inMan_IMP_ZAD;
    ELSE
        outIMP_LEV := FALSE;
        outIMP_PRA := FALSE;
        outIMP_ZAD := FALSE;
    END_IF
    eState      := 0;
    outTechstav := 0;
    tImpLEV(IN := FALSE);
tWaitL(IN := FALSE);
    RETURN;
END_IF

// ═══════════════════════════════════════════════════════════════════════
// Auto guard: VYHYBKY must be asserted
// ═══════════════════════════════════════════════════════════════════════
IF NOT inVYHYBKY THEN
    outIMP_LEV  := FALSE;
    outIMP_PRA  := FALSE;
    outIMP_ZAD  := FALSE;
    eState      := 0;
    outTechstav := 0;
    RETURN;
END_IF

tMismatch(IN := (inVYH_LEV <> inVYH_PRA), PT := T#200MS);
IF tMismatch.Q THEN
    bFault_latch    := TRUE;
    wFaultCode_hold := 16#0003;
END_IF

// --- Compute required switch position ---
// Forward (KLADNY=1): outer track (VYH=1); Reverse (OPACNY=1): inner track (VYH=0)
rtrigHRA_PRA(CLK := inHRA_PRA);

IF inKLADNY THEN
    // Forward — trigger immediately, no debounce needed
    IF rtrigHRA_PRA.Q THEN
        bTargetOuter := NOT bTargetOuter;
    END_IF
    tDebounce(IN := FALSE);
    bDebouncing := FALSE;

ELSIF inOPACNY THEN
    IF rtrigHRA_PRA.Q AND NOT bDebouncing AND NOT bPending THEN
        bPending    := TRUE;   // arm the pre-switch delay
        bDebouncing := TRUE;
    END_IF

    // Pre-switch delay — wait before actually toggling
    tPreSwitch(IN := bPending, PT := T#1000MS);  // adjust to carriage clearance time
    IF tPreSwitch.Q THEN
        bTargetOuter := NOT bTargetOuter;  // NOW toggle
        bPending     := FALSE;
        tPreSwitch(IN := FALSE);
    END_IF

    // Debounce — ignore further edges until whole train has passed
    tDebounce(IN := bDebouncing, PT := T#2000MS);
    IF tDebounce.Q THEN
        tDebounce(IN := FALSE);
        bDebouncing := FALSE;
    END_IF
END_IF
bReqOuter  := bTargetOuter;
bLEV_Wrong := (inVYH_LEV <> bReqOuter);
bPRA_Wrong := (inVYH_PRA <> bReqOuter);

// --- L4b state machine ---
CASE eState OF

   0: // IDLE
    outIMP_LEV := FALSE;
    outIMP_PRA := FALSE;
    tImpLEV(IN := FALSE);
    tWaitL(IN := FALSE);
    IF bLEV_Wrong AND NOT inHRA_LEV AND NOT inHRA_PRA THEN
        eState := 1;
    END_IF

    
1: // IMPULSE — fire both at once
    outIMP_LEV := TRUE;
    outIMP_PRA := TRUE;
    tImpLEV(IN := TRUE, PT := c_tImpulseMax);
    IF (NOT bLEV_Wrong AND NOT bPRA_Wrong) OR tImpLEV.Q THEN
        outIMP_LEV := FALSE;
        outIMP_PRA := FALSE;
        tImpLEV(IN := FALSE);
        eState := 2;
    END_IF

2: // WAIT settle
    tWaitL(IN := TRUE, PT := T#50MS);
    IF tWaitL.Q THEN
        tWaitL(IN := FALSE);
        eState := 0;
    END_IF

END_CASE

outTechstav := INT_TO_BYTE(eState);
]]></ST>
    </Implementation>
