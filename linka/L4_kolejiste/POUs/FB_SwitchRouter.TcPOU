<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="FB_SwitchRouter" Id="{a1b2c3d4-0006-4000-8000-000000000006}" SpecialFunc="None">
    <Declaration><![CDATA[// L4b — Switch routing (výhybkový automat).
// Aligns left (C) and right (D) double-track switches based on drive direction.
// State machine: IDLE → IMPULSE_C → CHECK_C → [IMPULSE_D → CHECK_D →] IDLE
// Impulse runs up to 1 s; stops early if position sensor confirms switch moved.
// Runs only when inEnable = TRUE (set by FB_MachineControl).
FUNCTION_BLOCK FB_SwitchRouter
VAR_INPUT
    inEnable      : BOOL;  // TRUE = auto mode active
    inManEnable   : BOOL;  // TRUE = manual mode active
    inVYHYBKY     : BOOL;  // PLC vlastní řízení výhybek (auto guard)
    inKLADNY      : BOOL;  // Jede v kladném směru
    inOPACNY      : BOOL;  // Jede v opačném směru
    inVYH_LEV     : BOOL;  // Poloha levé výhybky (1 = vnější kolej)
    inVYH_PRA     : BOOL;  // Poloha pravé výhybky (1 = vnější kolej)
    inHRA_LEV     : BOOL;  // SP1 — vozidlo na levém hradle (nesmí přestavovat)
    inHRA_PRA     : BOOL;  // Vozidlo na pravém hradle (nesmí přestavovat)

    // Manual overrides
    inMan_IMP_LEV : BOOL;
    inMan_IMP_PRA : BOOL;
    inMan_IMP_ZAD : BOOL;
END_VAR
VAR_OUTPUT
    outIMP_LEV  : BOOL;  // Impuls levé výhybky
    outIMP_PRA  : BOOL;  // Impuls pravé výhybky
    outIMP_ZAD  : BOOL;  // Impuls zadní výhybky (rozšíření)
    outFault     : BOOL;
    outFaultCode : WORD;
    outTechstav  : BYTE;  // Stav L4b: 0=IDLE,1=IMP_C,2=CHECK_C,3=IMP_D,4=CHECK_D (→ low byte MW104)
END_VAR
VAR
    eState          : INT := 0;
    // 0=IDLE, 1=IMPULSE_C, 2=CHECK_C, 3=IMPULSE_D, 4=CHECK_D

    bReqOuter       : BOOL;  // Požadovaná poloha: TRUE = vnější kolej (kladný směr)
    bLEV_Wrong      : BOOL;  // Levá výhybka v nesprávné poloze
    bPRA_Wrong      : BOOL;  // Pravá výhybka v nesprávné poloze

    tImpulseHold    : TON;   // Max délka impulsu (1 s)

    c_tImpulseMax   : TIME := T#1000MS;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ═══════════════════════════════════════════════════════════════════════
// Manual mode — bypass state machine
// ═══════════════════════════════════════════════════════════════════════
IF NOT inEnable THEN
    IF inManEnable THEN
        IF inVYH_LEV <> inVYH_PRA THEN
            outFault     := TRUE;
            outFaultCode := 16#0003;  // Výhybky nejsou ve stejné poloze
        END_IF
        // Parallel rails: switching one side must always switch both
        outIMP_LEV := inMan_IMP_LEV OR inMan_IMP_PRA;
        outIMP_PRA := inMan_IMP_LEV OR inMan_IMP_PRA;
        outIMP_ZAD := inMan_IMP_ZAD;
    ELSE
        outIMP_LEV := FALSE;
        outIMP_PRA := FALSE;
        outIMP_ZAD := FALSE;
    END_IF
    eState      := 0;
    outTechstav := 0;
    tImpulseHold(IN := FALSE);
    RETURN;
END_IF

// ═══════════════════════════════════════════════════════════════════════
// Auto guard: VYHYBKY must be asserted
// ═══════════════════════════════════════════════════════════════════════
IF NOT inVYHYBKY THEN
    outIMP_LEV  := FALSE;
    outIMP_PRA  := FALSE;
    outIMP_ZAD  := FALSE;
    eState      := 0;
    outTechstav := 0;
    RETURN;
END_IF

// --- Mismatch between parallel rails is always a fault ---
IF inVYH_LEV <> inVYH_PRA THEN
    outFault     := TRUE;
    outFaultCode := 16#0003;  // Výhybky nejsou ve stejné poloze
END_IF

// --- Compute required switch position ---
// Forward (KLADNY=1): outer track (VYH=1); Reverse (OPACNY=1): inner track (VYH=0)
bReqOuter := inKLADNY AND NOT inOPACNY;
bLEV_Wrong := (inVYH_LEV <> bReqOuter);
bPRA_Wrong := (inVYH_PRA <> bReqOuter);

// --- L4b state machine ---
CASE eState OF

    0: // IDLE — kontrola poloh výhybek
        outIMP_LEV := FALSE;
        outIMP_PRA := FALSE;
        outIMP_ZAD := FALSE;
        tImpulseHold(IN := FALSE);
        IF bLEV_Wrong AND NOT inHRA_LEV THEN
            eState := 1;
        ELSIF NOT bLEV_Wrong AND bPRA_Wrong AND NOT inHRA_PRA THEN
            eState := 3;
        END_IF

    1: // IMPULSE_C — impuls levé výhybky, max 1 s nebo dokud se nepřestaví
        outIMP_LEV := TRUE;
        tImpulseHold(IN := TRUE, PT := c_tImpulseMax);
        IF NOT bLEV_Wrong OR tImpulseHold.Q THEN
            outIMP_LEV := FALSE;
            tImpulseHold(IN := FALSE);
            eState := 2;
        END_IF

    2: // CHECK_C — ověření polohy levé výhybky po impulsu
        outIMP_LEV := FALSE;
        IF bLEV_Wrong THEN
            outFault     := TRUE;
            outFaultCode := 16#0001;  // Levá výhybka se nepřestavila
        END_IF
        IF bPRA_Wrong AND NOT inHRA_PRA THEN
            eState := 3;
        ELSE
            eState := 0;
        END_IF

    3: // IMPULSE_D — impuls pravé výhybky, max 1 s nebo dokud se nepřestaví
        outIMP_PRA := TRUE;
        tImpulseHold(IN := TRUE, PT := c_tImpulseMax);
        IF NOT bPRA_Wrong OR tImpulseHold.Q THEN
            outIMP_PRA := FALSE;
            tImpulseHold(IN := FALSE);
            eState := 4;
        END_IF

    4: // CHECK_D — ověření polohy pravé výhybky po impulsu
        outIMP_PRA := FALSE;
        IF bPRA_Wrong THEN
            outFault     := TRUE;
            outFaultCode := 16#0002;  // Pravá výhybka se nepřestavila
        END_IF
        eState := 0;

END_CASE

outTechstav := INT_TO_BYTE(eState);
]]></ST>
    </Implementation>
    <LineIds Name="FB_SwitchRouter">
      <LineId Id="9" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>
