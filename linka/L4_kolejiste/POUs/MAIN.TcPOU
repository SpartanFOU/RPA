<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="MAIN" Id="{7dc3db17-2a30-41bf-9b36-69d0883b3530}" SpecialFunc="None">
    <Declaration><![CDATA[// Top-level program.
// Instantiates all function blocks and wires their ports.
// No control logic lives here — only signal routing.
PROGRAM MAIN
VAR
    fbIO            : FB_IO;
    fbMachine       : FB_MachineControl;
    fbBarrier       : FB_Barrier;
    fbSwitchRouter  : FB_SwitchRouter;
    fbDrive         : FB_DriveCtrl;

    // One-scan pulse when CLEARING state is entered — clears fault latches
    rClearing       : R_TRIG;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ═══════════════════════════════════════════════════════════════════════
// 1. Machine control — runs first so enable signals are valid this scan
// ═══════════════════════════════════════════════════════════════════════
fbMachine(
    // HW buttons
    // In simulation: leave HW buttons FALSE — use SCADA M-variables instead.
    // On real HW: map these to physical DI inputs via FB_IO.
    inBTN_Start     := FALSE,
    inBTN_Reset     := FALSE,
    inBTN_Stop      := FALSE,
    inBTN_Man       := FALSE,
    inBTN_EStop     := TRUE,    // NC input — TRUE = safe. No HW wired in simulation.

    // SCADA M-variables (%M100.x) — use these to control from TwinCAT Watch window
    inSCADA_Start   := SCADA.SCADA_START,
    inSCADA_Reset   := SCADA.SCADA_RESET,
    inSCADA_Stop    := SCADA.SCADA_STOP,
    inSCADA_Man     := SCADA.SCADA_MAN,
    inSCADA_EStop   := SCADA.SCADA_ESTOP,

    inServicePin    := 0,       // Wire to HMI PIN input when VIS_Main is built

    inFault_Barrier := fbBarrier.outFault,
    inFault_Switch  := fbSwitchRouter.outFault,
    inFault_Drive   := fbDrive.outFault
);

// Detect entry into CLEARING state → one-scan pulse to clear fault latches
rClearing(CLK := (fbMachine.outState = E_SystemState.CLEARING));

// ═══════════════════════════════════════════════════════════════════════
// 2. Read physical I/O (inputs read here; outputs written at end)
// ═══════════════════════════════════════════════════════════════════════
fbIO(
    inKLADNY    := fbDrive.outKLADNY,
    inOPACNY    := fbDrive.outOPACNY,
    inZAVORY    := fbBarrier.outZAVORY,
    inIMP_LEV   := fbSwitchRouter.outIMP_LEV,
    inIMP_PRA   := fbSwitchRouter.outIMP_PRA,
    inIMP_ZAD   := fbSwitchRouter.outIMP_ZAD,
    inVYHYBKY   := fbMachine.outEnable_Auto OR fbMachine.outEnable_Man,
    inJIZDA     := fbDrive.outJIZDA
);

// ═══════════════════════════════════════════════════════════════════════
// 3. Drive control
// ═══════════════════════════════════════════════════════════════════════
fbDrive(
    inEnable        := fbMachine.outEnable_Auto OR fbMachine.outEnable_Man,
    inClearFault    := rClearing.Q,
    // Auto: direction from operator direction switch (PRE_KLA / PRE_OPA)
    inKLADNY_cmd    := fbIO.outPRE_KLA AND fbMachine.outEnable_Auto,
    inOPACNY_cmd    := fbIO.outPRE_OPA AND fbMachine.outEnable_Auto,
    inPRE_KLA       := fbIO.outPRE_KLA,
    inPRE_OPA       := fbIO.outPRE_OPA,
    // Manual: SCADA M101.0 / M101.1
    inMan_Kladny    := SCADA.SCADA_MAN_KLADNY AND fbMachine.outEnable_Man,
    inMan_Opacny    := SCADA.SCADA_MAN_OPACNY AND fbMachine.outEnable_Man
);

// ═══════════════════════════════════════════════════════════════════════
// 4. Barrier control — L4a
// ═══════════════════════════════════════════════════════════════════════
fbBarrier(
    inEnable        := fbMachine.outEnable_Auto,
    inManEnable     := fbMachine.outEnable_Man,
    inSP2           := fbIO.outHRA_ZAV,
    inJIZDA         := fbDrive.outJIZDA,
    // Manual: SCADA M101.2
    inMan_Zavory    := SCADA.SCADA_MAN_ZAVORY AND fbMachine.outEnable_Man
);

// ═══════════════════════════════════════════════════════════════════════
// 5. Switch routing — L4b
// ═══════════════════════════════════════════════════════════════════════
fbSwitchRouter(
    inEnable        := fbMachine.outEnable_Auto,
    inManEnable     := fbMachine.outEnable_Man,
    inVYHYBKY       := fbMachine.outEnable_Auto OR fbMachine.outEnable_Man,
    inKLADNY        := fbDrive.outKLADNY,
    inOPACNY        := fbDrive.outOPACNY,
    inVYH_LEV       := fbIO.outVYH_LEV,
    inVYH_PRA       := fbIO.outVYH_PRA,
    inHRA_LEV       := fbIO.outHRA_LEV,
    inHRA_PRA       := fbIO.outHRA_PRA,
    // Manual: SCADA M101.3 / M101.4 / M101.5
    inMan_IMP_LEV   := SCADA.SCADA_MAN_IMP_LEV AND fbMachine.outEnable_Man,
    inMan_IMP_PRA   := SCADA.SCADA_MAN_IMP_PRA AND fbMachine.outEnable_Man,
    inMan_IMP_ZAD   := SCADA.SCADA_MAN_IMP_ZAD AND fbMachine.outEnable_Man
);

// ═══════════════════════════════════════════════════════════════════════
// 6. Publish techstav → %MW104
//    High byte = L4a (barrier state), low byte = L4b (switch state)
// ═══════════════════════════════════════════════════════════════════════
SCADA.techstav := SHL(BYTE_TO_WORD(fbBarrier.outTechstav), 8)
               OR BYTE_TO_WORD(fbSwitchRouter.outTechstav);
]]></ST>
    </Implementation>
    <LineIds Name="MAIN">
      <LineId Id="9" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>
