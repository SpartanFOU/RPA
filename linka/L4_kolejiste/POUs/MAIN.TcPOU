      <LineId Id="167" Count="4" />
      <LineId Id="56" Count="9" />
      <LineId Id="135" Count="9" />
      <LineId Id="74" Count="9" />
      <LineId Id="133" Count="1" />
      <LineId Id="86" Count="13" />
      <LineId Id="2" Count="0" />
      <LineId Id="101" Count="1" />
    </LineIds>
  </POU>
</TcPlcObject>