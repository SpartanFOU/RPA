<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="FB_State_Manual" Id="{b100000C-000C-4000-8000-00000000000C}" SpecialFunc="None">
    <Declaration><![CDATA[// State handler: MANUAL
// Manual commands pass through. STOP edge → STOPPED.
// Correct service PIN → SERVICE.
FUNCTION_BLOCK FB_State_Manual
VAR_INPUT
    bExecute        : BOOL;
    bStop           : BOOL;   // Edge from MachineControl
    inServicePin    : INT;    // 4-digit PIN from operator
END_VAR
VAR_OUTPUT
    outCmd          : E_StateCmd := E_StateCmd.NONE;
    outEnable_Auto  : BOOL;
    outEnable_Man   : BOOL;
    outServiceMode  : BOOL;
    outgvFault      : BOOL;
    outInit_VYHYBKY : BOOL;
    outInit_IMP_LEV : BOOL;
    outInit_IMP_PRA : BOOL;
END_VAR
VAR
    c_ServicePin    : INT := 1234;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT bExecute THEN
    outCmd          := E_StateCmd.NONE;
    outEnable_Auto  := FALSE;
    outEnable_Man   := FALSE;
    outServiceMode  := FALSE;
    outgvFault      := FALSE;
    outInit_VYHYBKY := FALSE;
    outInit_IMP_LEV := FALSE;
    outInit_IMP_PRA := FALSE;
    RETURN;
END_IF

outEnable_Auto  := FALSE;
outEnable_Man   := TRUE;    // Manual commands enabled
outServiceMode  := FALSE;
outgvFault      := FALSE;
outInit_VYHYBKY := FALSE;
outInit_IMP_LEV := FALSE;
outInit_IMP_PRA := FALSE;

IF bStop THEN
    outCmd := E_StateCmd.TO_STOPPED;
ELSIF (inServicePin = c_ServicePin) AND (inServicePin <> 0) THEN
    outCmd := E_StateCmd.TO_SERVICE;
ELSE
    outCmd := E_StateCmd.NONE;
END_IF
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
