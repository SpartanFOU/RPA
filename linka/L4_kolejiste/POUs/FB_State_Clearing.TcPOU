<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="FB_State_Clearing" Id="{b100000B-000B-4000-8000-00000000000B}" SpecialFunc="None">
    <Declaration><![CDATA[// State handler: CLEARING
// Transient state — clears fault flag and immediately signals → STOPPED.
// Add hardware reset commands here if needed.
FUNCTION_BLOCK FB_State_Clearing
VAR_INPUT
    bExecute    : BOOL;
END_VAR
VAR_OUTPUT
    outCmd          : E_StateCmd := E_StateCmd.NONE;
    outEnable_Auto  : BOOL;
    outEnable_Man   : BOOL;
    outServiceMode  : BOOL;
    outgvFault      : BOOL;
    outInit_VYHYBKY : BOOL;
    outInit_IMP_LEV : BOOL;
    outInit_IMP_PRA : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT bExecute THEN
    outCmd          := E_StateCmd.NONE;
    outEnable_Auto  := FALSE;
    outEnable_Man   := FALSE;
    outServiceMode  := FALSE;
    outgvFault      := FALSE;
    outInit_VYHYBKY := FALSE;
    outInit_IMP_LEV := FALSE;
    outInit_IMP_PRA := FALSE;
    RETURN;
END_IF

outEnable_Auto  := FALSE;
outEnable_Man   := FALSE;
outServiceMode  := FALSE;
outgvFault      := FALSE;   // Fault cleared
outInit_VYHYBKY := FALSE;
outInit_IMP_LEV := FALSE;
outInit_IMP_PRA := FALSE;

// Immediate transition
outCmd := E_StateCmd.TO_STOPPED;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
