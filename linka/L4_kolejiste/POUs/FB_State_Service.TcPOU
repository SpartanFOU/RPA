<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="FB_State_Service" Id="{b100000D-000D-4000-8000-00000000000D}" SpecialFunc="None">
    <Declaration><![CDATA[// State handler: SERVICE
// Anti-collision bypassed (outServiceMode = TRUE).
// Auto-exits after c_tServiceTimeout or on STOP edge → back to MANUAL.
FUNCTION_BLOCK FB_State_Service
VAR_INPUT
    bExecute    : BOOL;
    bStop       : BOOL;   // Edge from MachineControl
END_VAR
VAR_OUTPUT
    outCmd          : E_StateCmd := E_StateCmd.NONE;
    outEnable_Auto  : BOOL;
    outEnable_Man   : BOOL;
    outServiceMode  : BOOL;
    outgvFault      : BOOL;
    outInit_VYHYBKY : BOOL;
    outInit_IMP_LEV : BOOL;
    outInit_IMP_PRA : BOOL;
END_VAR
VAR
    tServiceTimeout     : TON;
    c_tServiceTimeout   : TIME := T#5M;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT bExecute THEN
    // Reset timer on exit
    outCmd          := E_StateCmd.NONE;
    outEnable_Auto  := FALSE;
    outEnable_Man   := FALSE;
    outServiceMode  := FALSE;
    outgvFault      := FALSE;
    outInit_VYHYBKY := FALSE;
    outInit_IMP_LEV := FALSE;
    outInit_IMP_PRA := FALSE;
    tServiceTimeout(IN := FALSE);
    RETURN;
END_IF

outEnable_Auto  := FALSE;
outEnable_Man   := TRUE;    // Manual commands still active
outServiceMode  := TRUE;    // Anti-collision bypassed
outgvFault      := FALSE;
outInit_VYHYBKY := FALSE;
outInit_IMP_LEV := FALSE;
outInit_IMP_PRA := FALSE;

tServiceTimeout(IN := TRUE, PT := c_tServiceTimeout);

IF tServiceTimeout.Q OR bStop THEN
    tServiceTimeout(IN := FALSE);
    outCmd := E_StateCmd.TO_MANUAL;
ELSE
    outCmd := E_StateCmd.NONE;
END_IF
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
