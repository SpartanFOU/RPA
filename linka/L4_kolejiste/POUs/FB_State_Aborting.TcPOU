<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="FB_State_Aborting" Id="{b1000009-0009-4000-8000-000000000009}" SpecialFunc="None">
    <Declaration><![CDATA[// State handler: ABORTING
// Transient state — raises fault flag and immediately signals → ABORTED.
// Add safe-stop sequencing here if needed.
FUNCTION_BLOCK FB_State_Aborting
VAR_INPUT
    bExecute    : BOOL;
END_VAR
VAR_OUTPUT
    outCmd          : E_StateCmd := E_StateCmd.NONE;
    outEnable_Auto  : BOOL;
    outEnable_Man   : BOOL;
    outServiceMode  : BOOL;
    outgvFault      : BOOL;
    outInit_VYHYBKY : BOOL;
    outInit_IMP_LEV : BOOL;
    outInit_IMP_PRA : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT bExecute THEN
    outCmd          := E_StateCmd.NONE;
    outEnable_Auto  := FALSE;
    outEnable_Man   := FALSE;
    outServiceMode  := FALSE;
    outgvFault      := FALSE;
    outInit_VYHYBKY := FALSE;
    outInit_IMP_LEV := FALSE;
    outInit_IMP_PRA := FALSE;
    RETURN;
END_IF

outEnable_Auto  := FALSE;
outEnable_Man   := FALSE;
outServiceMode  := FALSE;
outgvFault      := TRUE;   // Fault active during abort
outInit_VYHYBKY := FALSE;
outInit_IMP_LEV := FALSE;
outInit_IMP_PRA := FALSE;

// Immediate transition
outCmd := E_StateCmd.TO_ABORTED;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
